# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dachhomeandbody?schema=public"
# Direct (non-pooled) connection — required by Prisma migrations on Supabase
DIRECT_URL="postgresql://user:password@localhost:5432/dachhomeandbody?schema=public"

# Environment — "development" locally, "production" on server
NODE_ENV="development"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here"
# The full URL of your app — must match exactly where Paystack redirects after payment
# Local dev: http://localhost:3000
# Production: https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Payment Gateways
PAYSTACK_SECRET_KEY="your-paystack-secret-key"
PAYSTACK_PUBLIC_KEY="your-paystack-public-key"
FLUTTERWAVE_SECRET_KEY="your-flutterwave-secret-key"
FLUTTERWAVE_PUBLIC_KEY="your-flutterwave-public-key"

# Image Storage
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Email Service
RESEND_API_KEY="your-resend-api-key"
# Set this once you've verified your domain in Resend (e.g. noreply@yourdomain.com)
# Leave unset to use Resend's shared test address (onboarding@resend.dev) during development
RESEND_FROM_EMAIL="DACH Home & Body <support@yourdomain.com>"

# Admin notification email — receives alerts when a Pay-For-Me request is fulfilled
ADMIN_EMAIL="support@yourdomain.com"

# AI Chatbot — Google Gemini
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# Cron job security — generate with: openssl rand -hex 32
# Set the same value in Vercel project settings under Environment Variables
CRON_SECRET="your-cron-secret-here"
